<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="28dp" android:background="#F4F7F5">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="G510 セルフオーダー" android:textSize="32sp" android:textStyle="bold" android:textColor="#17352A"/>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="音声またはキーボードで注文してください" android:textSize="20sp" android:textColor="#365E50"/>
    <EditText android:id="@+id/input" android:layout_width="match_parent" android:layout_height="64dp"
        android:layout_marginTop="20dp" android:hint="例: コーヒーを2つ、サンドイッチを1つ" android:textSize="20sp"
        android:padding="14dp" android:backgroundTint="#006C4C" android:singleLine="true"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
        <Button android:id="@+id/voiceButton" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1"
            android:text="音声で注文" android:textSize="20sp"/>
        <Button android:id="@+id/addButton" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1"
            android:layout_marginStart="16dp" android:text="注文に追加" android:textSize="20sp"/>
    </LinearLayout>
    <TextView android:id="@+id/orderResult" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="22dp" android:padding="20dp" android:text="注文内容はここに表示されます" android:textSize="24sp"
        android:textColor="#17352A" android:background="#FFFFFF"/>
    <Button android:id="@+id/clearButton" android:layout_width="match_parent" android:layout_height="58dp"
        android:layout_marginTop="16dp" android:text="注文をクリア" android:textSize="18sp"/>
</LinearLayout>
