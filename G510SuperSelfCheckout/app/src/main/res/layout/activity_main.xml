<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="#F5F3EE" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:background="#123B37" android:gravity="center_vertical" android:paddingLeft="22dp" android:paddingRight="16dp" android:layout_width="match_parent" android:layout_height="66dp"><TextView android:text="G510 スーパーセルフレジ" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="24sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><TextView android:id="@+id/status" android:text="商品を選択してください" android:textColor="#F9C35B" android:textSize="16sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
 <LinearLayout android:orientation="horizontal" android:padding="10dp" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="3" android:layout_height="match_parent">
   <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="56dp"><Button android:id="@+id/tabFood" android:text="食品" android:textSize="17sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/><Button android:id="@+id/tabDrink" android:text="飲料" android:textSize="17sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/><Button android:id="@+id/tabProduce" android:text="青果" android:textSize="17sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/><Button android:id="@+id/tabDaily" android:text="日用品" android:textSize="17sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/></LinearLayout>
   <GridLayout android:id="@+id/productGrid" android:columnCount="3" android:rowCount="2" android:padding="4dp" android:layout_weight="1" android:layout_width="match_parent" android:layout_height="0dp"/>
   <LinearLayout android:gravity="center_vertical" android:padding="5dp" android:layout_width="match_parent" android:layout_height="61dp"><EditText android:id="@+id/barcode" android:hint="バーコード番号を入力" android:inputType="number" android:textSize="17sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/><Button android:id="@+id/scan" android:text="読取デモ" android:textSize="17sp" android:layout_width="160dp" android:layout_height="match_parent"/></LinearLayout>
  </LinearLayout>
  <LinearLayout android:orientation="vertical" android:background="#FFFFFF" android:padding="15dp" android:layout_marginLeft="10dp" android:layout_width="0dp" android:layout_weight="1.25" android:layout_height="match_parent"><TextView android:text="お買い上げ商品" android:textColor="#123B37" android:textStyle="bold" android:textSize="21sp" android:layout_width="match_parent" android:layout_height="wrap_content"/><ScrollView android:layout_weight="1" android:layout_width="match_parent" android:layout_height="0dp"><TextView android:id="@+id/cart" android:text="商品はありません" android:textColor="#263632" android:textSize="16sp" android:lineSpacingExtra="7dp" android:paddingTop="13dp" android:layout_width="match_parent" android:layout_height="wrap_content"/></ScrollView><TextView android:id="@+id/subtotal" android:text="小計 0円" android:textSize="17sp" android:gravity="right" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/tax" android:text="消費税 0円" android:textSize="15sp" android:textColor="#666666" android:gravity="right" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/total" android:text="合計 0円" android:textColor="#E85D3F" android:textStyle="bold" android:textSize="26sp" android:gravity="right" android:paddingTop="5dp" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><Button android:id="@+id/pay" android:text="お支払いへ" android:textSize="20sp" android:layout_width="match_parent" android:layout_height="62dp"/><Button android:id="@+id/clear" android:text="取消・最初から" android:layout_marginTop="7dp" android:layout_width="match_parent" android:layout_height="48dp"/></LinearLayout>
 </LinearLayout>
</LinearLayout>
