<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal" android:background="#101318">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="緊急音警報デモ" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold"/>
    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="24dp" android:gravity="center" android:text="停止中" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" android:background="#263238"/>
    <TextView android:id="@+id/detailText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="マイク監視を開始してください" android:textColor="#DDE3EA" android:textSize="17sp"/>
    <ProgressBar android:id="@+id/levelBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="20dp" android:max="100"/>
    <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="24dp" android:text="監視開始" android:textSize="20sp"/>
    <Button android:id="@+id/testButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="警報テスト"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="デモ判定: 周期的なサイレン音と大音量の変調音を検出します。実運用には学習済み音響分類モデルが必要です。" android:textColor="#9FA8B3" android:textSize="14sp"/>
</LinearLayout>
