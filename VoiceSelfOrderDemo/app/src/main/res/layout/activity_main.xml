<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#FFF8F1" android:padding="18dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="VOICE SELF ORDER" android:textStyle="bold" android:textSize="28sp" android:textColor="#B71C1C"/>
        <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="準備中" android:textStyle="bold" android:textSize="18sp" android:textColor="#00695C"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:layout_marginTop="14dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.35"
            android:orientation="vertical" android:background="@android:color/white" android:padding="18dp">
            <TextView android:text="AIコンシェルジュ" android:textStyle="bold" android:textSize="18sp"
                android:textColor="#555555" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/guideText" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:gravity="center" android:text="いらっしゃいませ"
                android:textStyle="bold" android:textSize="34sp" android:textColor="#222222"/>
            <TextView android:id="@+id/heardText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="58dp" android:gravity="center" android:padding="10dp" android:background="#E8F5E9"
                android:text="認識結果がここに表示されます" android:textSize="20sp" android:textColor="#1B5E20"/>
            <Button android:id="@+id/micButton" android:layout_width="match_parent" android:layout_height="58dp"
                android:layout_marginTop="12dp" android:text="🎤  話して注文" android:textSize="20sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="16dp" android:orientation="vertical" android:background="@android:color/white" android:padding="16dp">
            <TextView android:text="ご注文内容" android:textStyle="bold" android:textSize="22sp" android:textColor="#333333"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/cartText" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:paddingTop="12dp" android:text="まだ商品はありません" android:textSize="20sp"/>
            <TextView android:id="@+id/totalText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="end" android:text="合計　¥0" android:textStyle="bold" android:textSize="26sp" android:textColor="#B71C1C"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/undoButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1つ戻す"/>
                <Button android:id="@+id/confirmButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3"
                    android:layout_marginStart="8dp" android:text="注文確定"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:paddingTop="8dp" android:text="例：『サーモンを2皿』『まぐろ1つ追加』『注文を取り消して』『以上です』" android:textSize="16sp" android:textColor="#555555"/>
</LinearLayout>
