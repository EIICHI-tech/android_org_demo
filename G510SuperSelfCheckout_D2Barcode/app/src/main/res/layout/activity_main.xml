<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical" android:background="#F5F3EE" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:background="#123B37" android:gravity="center_vertical" android:paddingLeft="20dp" android:paddingRight="12dp" android:layout_width="match_parent" android:layout_height="62dp">
  <TextView android:text="G510 D2カメラ AIセルフレジ" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="23sp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
  <Spinner android:id="@+id/cameraSpinner" android:background="#FFFFFF" android:layout_width="145dp" android:layout_height="44dp"/>
  <Button android:id="@+id/switchCamera" android:text="カメラ切替" android:layout_marginLeft="6dp" android:layout_width="125dp" android:layout_height="46dp"/>
 </LinearLayout>
 <LinearLayout android:orientation="horizontal" android:padding="8dp" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1.65" android:layout_height="match_parent">
   <com.journeyapps.barcodescanner.DecoratedBarcodeView android:id="@+id/barcodeView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" app:zxing_scanner_layout="@layout/zxing_barcode_scanner"/>
   <TextView android:id="@+id/scanStatus" android:text="JANコードを枠内にかざしてください" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="17sp" android:gravity="center" android:background="#123B37" android:layout_width="match_parent" android:layout_height="48dp"/>
   <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="52dp"><Button android:id="@+id/pause" android:text="読取を一時停止" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/><Button android:id="@+id/torch" android:text="照明 ON/OFF" android:layout_weight="1" android:layout_width="0dp" android:layout_height="match_parent"/></LinearLayout>
  </LinearLayout>
  <LinearLayout android:orientation="vertical" android:layout_marginLeft="8dp" android:layout_width="0dp" android:layout_weight="2.35" android:layout_height="match_parent">
   <HorizontalScrollView android:layout_width="match_parent" android:layout_height="52dp"><LinearLayout android:id="@+id/tabs" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="match_parent"/></HorizontalScrollView>
   <GridLayout android:id="@+id/grid" android:columnCount="3" android:rowCount="2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
  </LinearLayout>
  <LinearLayout android:orientation="vertical" android:background="#FFFFFF" android:padding="12dp" android:layout_marginLeft="8dp" android:layout_width="0dp" android:layout_weight="1.1" android:layout_height="match_parent">
   <TextView android:text="お買い上げ商品" android:textSize="19sp" android:textStyle="bold" android:textColor="#123B37" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><TextView android:id="@+id/cart" android:text="商品はありません" android:textSize="14sp" android:lineSpacingExtra="5dp" android:paddingTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/></ScrollView>
   <TextView android:id="@+id/total" android:text="合計 0円" android:textColor="#E85D3F" android:textStyle="bold" android:textSize="23sp" android:gravity="right" android:padding="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <Button android:id="@+id/pay" android:text="お支払いへ" android:textSize="18sp" android:layout_width="match_parent" android:layout_height="58dp"/>
   <Button android:id="@+id/clear" android:text="取消・最初から" android:layout_marginTop="5dp" android:layout_width="match_parent" android:layout_height="46dp"/>
  </LinearLayout>
 </LinearLayout>
</LinearLayout>
