<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#102A38">

    <TextView android:id="@+id/titleText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Hi エレベーター" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold" android:gravity="center" android:paddingBottom="10dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:background="@drawable/display_bg" android:padding="14dp">
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="『Hi エレベーター』と話してください" android:textColor="#31E981" android:textSize="20sp" android:gravity="center" android:minHeight="58dp"/>
        <TextView android:id="@+id/heardText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="待機中" android:textColor="#B2FFCC" android:textSize="14sp" android:gravity="center"/>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="行き先階"
        android:textColor="#E8F3F8" android:textSize="18sp" android:gravity="center" android:padding="10dp"/>

    <GridLayout android:id="@+id/floorGrid" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:columnCount="5" android:rowCount="6" android:alignmentMode="alignMargins"/>

    <TextView android:id="@+id/hintText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="起動後はボタン操作不要です" android:textColor="#B0BEC5" android:textSize="13sp" android:gravity="center" android:paddingTop="8dp"/>
</LinearLayout>
